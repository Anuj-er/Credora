pragma solidity ^0.8.20;

/// @title CertificateRegistry
/// @notice Stores only a salted commitment to a credential, never student data.
/// @dev The credential ID is a random, non-identifying reference generated by Credora.
contract CertificateRegistry {
    struct Certificate {
        bytes32 credentialHash;
        address issuer;
        uint256 issuedAt;
        bool isRevoked;
        uint256 revokedAt;
    }

    struct AuditEntry {
        string action;
        address performedBy;
        uint256 timestamp;
    }

    address public owner;
    mapping(string => Certificate) public certificates;
    mapping(string => AuditEntry[]) private auditTrails;
    mapping(address => string[]) private issuerCertificates;
    mapping(address => bool) public authorizedIssuers;

    event CertificateIssued(
        string indexed certificateId,
        address indexed issuer,
        bytes32 credentialHash,
        uint256 timestamp
    );
    event CertificateRevoked(
        string indexed certificateId,
        address indexed revokedBy,
        uint256 timestamp
    );
    event IssuerAuthorized(address indexed issuer, uint256 timestamp);
    event IssuerRevoked(address indexed issuer, uint256 timestamp);

    modifier onlyOwner() {
        require(msg.sender == owner, "Only owner can call this function");
        _;
    }

    modifier onlyAuthorizedIssuer() {
        require(authorizedIssuers[msg.sender], "Only authorized issuers can call this function");
        _;
    }

    constructor() {
        owner = msg.sender;
    }

    function authorizeIssuer(address issuer) external onlyOwner {
        require(issuer != address(0), "Invalid issuer address");
        require(!authorizedIssuers[issuer], "Issuer already authorized");
        authorizedIssuers[issuer] = true;
        emit IssuerAuthorized(issuer, block.timestamp);
    }

    function revokeIssuer(address issuer) external onlyOwner {
        require(authorizedIssuers[issuer], "Issuer not authorized");
        authorizedIssuers[issuer] = false;
        emit IssuerRevoked(issuer, block.timestamp);
    }

    function isAuthorizedIssuer(address issuer) external view returns (bool) {
        return authorizedIssuers[issuer];
    }

    function issueCertificate(string calldata certificateId, bytes32 credentialHash)
        external
        onlyAuthorizedIssuer
    {
        require(bytes(certificateId).length > 0, "Certificate ID cannot be empty");
        require(credentialHash != bytes32(0), "Credential proof cannot be empty");
        require(certificates[certificateId].credentialHash == bytes32(0), "Certificate already exists");

        certificates[certificateId] = Certificate({
            credentialHash: credentialHash,
            issuer: msg.sender,
            issuedAt: block.timestamp,
            isRevoked: false,
            revokedAt: 0
        });
        issuerCertificates[msg.sender].push(certificateId);
        auditTrails[certificateId].push(AuditEntry("ISSUED", msg.sender, block.timestamp));

        emit CertificateIssued(certificateId, msg.sender, credentialHash, block.timestamp);
    }

    function verifyCertificate(string calldata certificateId)
        external
        view
        returns (Certificate memory)
    {
        Certificate memory certificate = certificates[certificateId];
        require(certificate.credentialHash != bytes32(0), "Certificate does not exist");
        return certificate;
    }

    function revokeCertificate(string calldata certificateId) external {
        Certificate storage certificate = certificates[certificateId];
        require(certificate.credentialHash != bytes32(0), "Certificate does not exist");
        require(certificate.issuer == msg.sender, "Only the original issuer can revoke");
        require(!certificate.isRevoked, "Certificate already revoked");

        certificate.isRevoked = true;
        certificate.revokedAt = block.timestamp;
        auditTrails[certificateId].push(AuditEntry("REVOKED", msg.sender, block.timestamp));
        emit CertificateRevoked(certificateId, msg.sender, block.timestamp);
    }

    function getCertificatesByIssuer(address issuer) external view returns (string[] memory) {
        return issuerCertificates[issuer];
    }

    function getAuditTrail(string calldata certificateId) external view returns (AuditEntry[] memory) {
        require(certificates[certificateId].credentialHash != bytes32(0), "Certificate does not exist");
        return auditTrails[certificateId];
    }
}
