    Cert --> Redis[("Redis / BullMQ<br/>issuance workers")]
    ChainSvc --> Sepolia[("Sepolia<br/>CertificateRegistry")]
    IPFSSvc --> Pinata[("Pinata<br/>encrypted backup")]
