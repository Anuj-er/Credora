# Shared by the gateway and backend services during local development.
NODE_ENV=development
LOG_LEVEL=info
SERVICE_NAME=credora

# Service ports (each service also accepts PORT as a one-process override)
GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
CERTIFICATE_SERVICE_PORT=3002
BLOCKCHAIN_SERVICE_PORT=3003
IPFS_SERVICE_PORT=3004

# MongoDB and Redis
MONGODB_URI=mongodb://localhost:27017/credora_local
# Docker Compose overrides this with its MongoDB container by default. Set this to an Atlas URI for a Docker app backed by Atlas.
DOCKER_MONGODB_URI=mongodb://mongodb:27017/credora_local
# For Atlas-backed local development, replace the value above in your private .env:
# mongodb+srv://<db_user>:<url_encoded_password>@<cluster-host>.mongodb.net/credora_local?retryWrites=true&w=majority&appName=credora
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication (replace with a long, random value before using real accounts)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Optional separate key for service-to-service requests; defaults to JWT_SECRET.
INTERNAL_SERVICE_TOKEN=replace-with-a-separate-long-random-secret

# Keep this encryption key stable; changing it makes stored certificate PDFs unreadable.
CERTIFICATE_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret

# Optional one-time local admin bootstrap. Keep these values private.
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=

# Browser and service routing
CORS_ORIGIN=http://localhost:5173
AUTH_SERVICE_URL=http://localhost:3001
CERTIFICATE_SERVICE_URL=http://localhost:3002
BLOCKCHAIN_SERVICE_URL=http://localhost:3003
IPFS_SERVICE_URL=http://localhost:3004
FRONTEND_URL=http://localhost:5173

# Backend blockchain RPC: local Hardhat by default; use the Sepolia endpoint for Sepolia.
HARDHAT_NETWORK_URL=http://127.0.0.1:8545
LOCAL_HARDHAT_RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=

# Docker Compose defaults to its private local Hardhat chain. For Sepolia, set all three DOCKER_* values to the matching RPC, contract, and deployer key.
DOCKER_HARDHAT_NETWORK_URL=http://hardhat-node:8545
DOCKER_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
DOCKER_DEPLOYER_PRIVATE_KEY=

# Only needed when deploying to Sepolia; leave empty for the local Hardhat chain.
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=

# Optional: without Pinata credentials, IPFS uploads use a local mock response.
PINATA_API_KEY=
PINATA_SECRET_KEY=
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/
